MONGO_URI=mongodb://localhost:27017/
# For MongoDB Atlas URI templates, keep the password out of MONGO_URI:
# MONGO_URI=mongodb+srv://user:<db_password>@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGO_PWD=your_atlas_password
DATABASE_NAME=legal_database
COLLECTION_NAME=laws_sections

FAISS_INDEX_PATH=faiss_index

CHUNK_SIZE=900
CHUNK_OVERLAP=150
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DEFAULT_TOP_K=5
MAX_TOP_K=20
SIMILARITY_SCORE_THRESHOLD=1.35

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_MAX_RETRIES=2
